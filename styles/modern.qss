/* ========================================
   现代化HR系统UI样式表
   设计理念：简约、现代、专业
   参考：微信、QQ、钉钉等现代软件设计
   ======================================== */

/* === 全局设计系统 === */
* {
    font-family: "Microsoft YaHei UI", "SF Pro Display", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    color: #2c3e50;
}

/* === 主窗口和背景 === */
QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                               stop:0 #f8fafc, stop:0.5 #f1f5f9, stop:1 #e2e8f0);
    border: none;
}

QWidget {
    background: transparent;
    border: none;
}

/* === 卡片容器设计 === */
QWidget#loginWidget, QWidget#registerWidget {
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(226, 232, 240, 0.6);
    border-radius: 20px;
    /* 现代化阴影效果 */
    /* Qt不直接支持box-shadow，使用替代方案 */
}

QWidget#cardContainer {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    margin: 8px;
    padding: 24px;
}

/* === 标题和文本样式 === */
QLabel#titleLabel {
    font-size: 32px;
    font-weight: 300;
    color: #1e293b;
    padding: 24px;
    letter-spacing: -0.5px;
}

QLabel#subtitleLabel {
    font-size: 16px;
    font-weight: 400;
    color: #64748b;
    padding: 0px 24px 16px 24px;
}

QLabel#sectionTitle {
    font-size: 18px;
    font-weight: 600;
    color: #374151;
    margin: 16px 0 8px 0;
}

/* === 现代化输入框设计 === */
QLineEdit {
    background: #f8fafc;
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    padding: 16px 20px;
    font-size: 15px;
    color: #1e293b;
    selection-background-color: #3b82f6;
    selection-color: white;
}

QLineEdit:focus {
    background: white;
    border-color: #3b82f6;
    outline: none;
}

QLineEdit:hover {
    border-color: #cbd5e1;
    background: #f1f5f9;
}

QLineEdit::placeholder {
    color: #94a3b8;
    font-style: italic;
}

/* === 现代化按钮设计 === */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #3b82f6, stop:1 #2563eb);
    color: white;
    border: none;
    border-radius: 12px;
    padding: 16px 32px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.025em;
    min-height: 20px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #2563eb, stop:1 #1d4ed8);
    transform: translateY(-1px);
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #1d4ed8, stop:1 #1e40af);
    transform: translateY(0px);
}

QPushButton:disabled {
    background: #e2e8f0;
    color: #94a3b8;
}

/* === 次要按钮样式 === */
QPushButton#secondaryButton {
    background: white;
    color: #374151;
    border: 2px solid #e5e7eb;
}

QPushButton#secondaryButton:hover {
    background: #f9fafb;
    border-color: #d1d5db;
    color: #111827;
}

QPushButton#secondaryButton:pressed {
    background: #f3f4f6;
    border-color: #9ca3af;
}

/* === 成功按钮样式 === */
QPushButton#successButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #10b981, stop:1 #059669);
}

QPushButton#successButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #059669, stop:1 #047857);
}

/* === 危险按钮样式 === */
QPushButton#dangerButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #ef4444, stop:1 #dc2626);
}

QPushButton#dangerButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #dc2626, stop:1 #b91c1c);
}

/* === 小按钮样式 === */
QPushButton#smallButton {
    padding: 8px 16px;
    font-size: 13px;
    border-radius: 8px;
    min-height: 16px;
}

/* === 现代化标签页设计 === */
QTabWidget {
    background: transparent;
    border: none;
}

QTabWidget::pane {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    margin-top: 8px;
    padding: 20px;
}

QTabBar {
    background: transparent;
    border: none;
}

QTabBar::tab {
    background: transparent;
    color: #64748b;
    padding: 12px 24px;
    margin-right: 4px;
    border: none;
    border-radius: 12px 12px 0px 0px;
    font-weight: 500;
    font-size: 15px;
    min-width: 100px;
}

QTabBar::tab:selected {
    background: white;
    color: #3b82f6;
    border-bottom: 3px solid #3b82f6;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
}

/* === 文本编辑器现代化设计 === */
QTextEdit {
    background: #f8fafc;
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    padding: 16px;
    font-size: 14px;
    line-height: 1.6;
    color: #374151;
    selection-background-color: #3b82f6;
    selection-color: white;
}

QTextEdit:focus {
    background: white;
    border-color: #3b82f6;
}

/* === 现代化列表设计 === */
QListWidget {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 8px;
    outline: none;
}

QListWidget::item {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 12px 16px;
    margin: 2px;
    color: #374151;
}

QListWidget::item:hover {
    background: #f1f5f9;
    color: #1e293b;
}

QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                               stop:0 #3b82f6, stop:1 #2563eb);
    color: white;
    border: none;
}

/* === 现代化表格设计 === */
QTableWidget {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    gridline-color: #f1f5f9;
    outline: none;
    selection-background-color: #eff6ff;
}

QTableWidget::item {
    padding: 12px;
    border-bottom: 1px solid #f1f5f9;
    color: #374151;
}

QTableWidget::item:selected {
    background: #eff6ff;
    color: #1e40af;
}

QTableWidget::item:hover {
    background: #f8fafc;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #f8fafc, stop:1 #f1f5f9);
    color: #374151;
    padding: 16px 12px;
    border: none;
    border-bottom: 2px solid #e5e7eb;
    border-right: 1px solid #e5e7eb;
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

QHeaderView::section:first {
    border-top-left-radius: 12px;
}

QHeaderView::section:last {
    border-top-right-radius: 12px;
    border-right: none;
}

/* === 现代化下拉框设计 === */
QComboBox {
    background: #f8fafc;
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 14px;
    color: #374151;
    min-width: 120px;
}

QComboBox:focus {
    background: white;
    border-color: #3b82f6;
}

QComboBox:hover {
    border-color: #cbd5e1;
    background: #f1f5f9;
}

QComboBox::drop-down {
    border: none;
    width: 32px;
    background: transparent;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 6px solid #6b7280;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 8px;
    outline: none;
    selection-background-color: #eff6ff;
    selection-color: #1e40af;
}

QComboBox QAbstractItemView::item {
    padding: 10px 16px;
    border: none;
    border-radius: 8px;
    margin: 2px;
}

QComboBox QAbstractItemView::item:hover {
    background: #f1f5f9;
}

QComboBox QAbstractItemView::item:selected {
    background: #eff6ff;
    color: #1e40af;
}

/* === 现代化复选框和单选框 === */
QCheckBox, QRadioButton {
    color: #374151;
    font-size: 14px;
    spacing: 12px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #d1d5db;
    background: white;
}

QCheckBox::indicator {
    border-radius: 6px;
}

QRadioButton::indicator {
    border-radius: 10px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #3b82f6;
    border-color: #3b82f6;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #9ca3af;
}

/* === 现代化滚动条 === */
QScrollBar:vertical {
    background: #f1f5f9;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #f1f5f9;
    height: 8px;
    border-radius: 4px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #cbd5e1;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* === 现代化分组框 === */
QGroupBox {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    margin: 12px 0;
    padding: 20px;
    font-weight: 600;
    color: #374151;
    font-size: 15px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    background: white;
    color: #374151;
}

/* === 现代化进度条 === */
QProgressBar {
    background: #f1f5f9;
    border: none;
    border-radius: 6px;
    height: 12px;
    text-align: center;
    color: #374151;
    font-size: 12px;
    font-weight: 500;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                               stop:0 #3b82f6, stop:1 #1d4ed8);
    border-radius: 6px;
}

/* === 菜单栏现代化设计 === */
QMenuBar {
    background: white;
    border-bottom: 1px solid #e5e7eb;
    color: #374151;
    padding: 8px;
    font-size: 14px;
}

QMenuBar::item {
    background: transparent;
    padding: 8px 16px;
    border-radius: 8px;
    margin: 0 2px;
}

QMenuBar::item:selected {
    background: #f1f5f9;
    color: #1e40af;
}

QMenuBar::item:pressed {
    background: #e2e8f0;
}

/* === 下拉菜单现代化设计 === */
QMenu {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 8px;
    color: #374151;
}

QMenu::item {
    padding: 10px 16px;
    border-radius: 8px;
    margin: 2px;
}

QMenu::item:selected {
    background: #f1f5f9;
    color: #1e40af;
}

QMenu::separator {
    height: 1px;
    background: #e5e7eb;
    margin: 8px 0;
}

/* === 状态栏现代化设计 === */
QStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #f8fafc, stop:1 #f1f5f9);
    border-top: 1px solid #e5e7eb;
    color: #6b7280;
    padding: 8px;
    font-size: 13px;
}

/* === 工具提示现代化设计 === */
QToolTip {
    background: rgba(55, 65, 81, 0.95);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 500;
}

/* === 特殊状态样式 === */
.success-message {
    background: #ecfdf5;
    border: 1px solid #10b981;
    border-radius: 8px;
    color: #065f46;
    padding: 12px 16px;
    font-weight: 500;
}

.error-message {
    background: #fef2f2;
    border: 1px solid #ef4444;
    border-radius: 8px;
    color: #991b1b;
    padding: 12px 16px;
    font-weight: 500;
}

.warning-message {
    background: #fffbeb;
    border: 1px solid #f59e0b;
    border-radius: 8px;
    color: #92400e;
    padding: 12px 16px;
    font-weight: 500;
}

.info-message {
    background: #eff6ff;
    border: 1px solid #3b82f6;
    border-radius: 8px;
    color: #1e40af;
    padding: 12px 16px;
    font-weight: 500;
}

/* === 卡片式统计面板 === */
QWidget#statsCard {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 24px;
    margin: 8px;
}

QLabel#statsNumber {
    font-size: 32px;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 4px;
}

QLabel#statsLabel {
    font-size: 14px;
    font-weight: 500;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

/* === 响应式设计增强 === */
QWidget:focus {
    outline: 2px solid #3b82f6;
    outline-offset: 2px;
}

/* === 深色模式支持 === */
QWidget[darkMode="true"] {
    background: #1e293b;
    color: #f1f5f9;
}

QWidget[darkMode="true"] QLineEdit {
    background: #334155;
    border-color: #475569;
    color: #f1f5f9;
}

QWidget[darkMode="true"] QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                               stop:0 #1e40af, stop:1 #1e3a8a);
}
